# Preserve archival datasets and binary publication artifacts byte for byte.
*.dat binary
*.npz binary
*.pdf binary

# Keep human-readable project sources consistent across platforms.
*.py text eol=lf
*.tex text eol=lf
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cff text eol=lf
*.txt text eol=lf
LICENSE text eol=lf

# Keep archived text evidence readable on GitHub while preserving its original
# bytes. Some frozen manifests bind these files by SHA-256, so Git must not
# normalize their line endings.
data/**/*.csv -text
results/**/*.csv -text
results/**/*.json -text
data/**/*.dat binary

# Preserve the exact upstream IEEE class and bibliography style files.
paper/IEEEtran.cls binary
paper/IEEEtranDoi.bst binary
